<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title || 'Formulaire Utilisateur' %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header>
    <nav>
      <ul>
        <li><a href="/tableau-de-bord">Tableau de bord</a></li>
        <li><a href="/users">Liste utilisateurs</a></li>
        <li><a href="/docs">Documentation API</a></li>
        <li><a href="#" id="logout-btn">Déconnexion</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <h1 id="form-title">Créer un utilisateur</h1>

    <form id="user-form">
      <input type="hidden" id="user-id" />
      <label for="name">Nom :</label>
      <input type="text" id="name" name="name" required /><br/>

      <label for="email">Email :</label>
      <input type="email" id="email" name="email" required /><br/>

      <label for="password">Mot de passe :</label>
      <input type="password" id="password" name="password" required /><br/>

      <label for="role">Rôle :</label>
      <select id="role" name="role" required>
        <option value="admin">Admin</option>
        <option value="user">Utilisateur</option>
      </select><br/>

      <button type="submit">Enregistrer</button>
    </form>
  </main>

  <script src="/js/user-form.js"></script>
</body>
</html>
