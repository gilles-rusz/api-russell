<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Gestion des Catways - Port de Russell</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <nav>
      <ul>
        <li><a href="/tableau-de-bord">Tableau de bord</a></li>
        <li><a href="/reservations">Réservations</a></li>
        <li><a href="/users">Utilisateurs</a></li>
        <li><a href="/docs">Documentation API</a></li>
        <li><a href="/logout">Déconnexion</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <h1>Gestion des Catways</h1>

    <section>
      <h2>Ajouter un Catway</h2>
      <form action="/catways" method="POST">
        <input type="text" name="name" placeholder="Nom" required>
        <input type="text" name="location" placeholder="Emplacement" required>
        <button type="submit">Ajouter</button>
      </form>
    </section>

    <section>
      <h2>Liste des Catways</h2>
      <table>
        <thead>
          <tr>
            <th>Nom</th>
            <th>Emplacement</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% catways.forEach(catway => { %>
            <tr>
              <td><%= catway.name %></td>
              <td><%= catway.location %></td>
              <td>
                <a href="/catways/<%= catway._id %>/edit">Modifier</a>
                <form action="/catways/<%= catway._id %>?_method=DELETE" method="POST" style="display:inline;">
                  <button type="submit">Supprimer</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
  </main>
</body>
</html>
