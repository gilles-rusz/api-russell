<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Gestion des Utilisateurs - Port de Russell</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <nav>
      <ul>
        <li><a href="/tableau-de-bord">Tableau de bord</a></li>
        <li><a href="/catways">Catways</a></li>
        <li><a href="/reservations">Réservations</a></li>
        <li><a href="/docs">Documentation API</a></li>
        <li><a href="/logout">Déconnexion</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <h1>Gestion des Utilisateurs</h1>

    <section>
      <h2>Créer un Utilisateur</h2>
      <form action="/users" method="POST">
        <input type="text" name="name" placeholder="Nom" required>
        <input type="email" name="email" placeholder="Email" required>
        <input type="password" name="password" placeholder="Mot de passe" required>
        <button type="submit">Créer</button>
      </form>
    </section>

    <section>
      <h2>Liste des Utilisateurs</h2>
      <table>
        <thead>
          <tr>
            <th>Nom</th>
            <th>Email</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(user => { %>
            <tr>
              <td><%= user.name %></td>
              <td><%= user.email %></td>
              <td>
                <a href="/users/<%= user._id %>/edit">Modifier</a>
                <form action="/users/<%= user._id %>?_method=DELETE" method="POST" style="display:inline;">
                  <button type="submit">Supprimer</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
  </main>
</body>
</html>
