<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Tableau de bord - Port de Russell</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <nav>
      <ul>
        <li><a href="/catways">Catways</a></li>
        <li><a href="/reservations">Réservations</a></li>
        <li><a href="/users">Utilisateurs</a></li>
        <li><a href="/docs">Documentation API</a></li>
        <li><a href="/logout">Déconnexion</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <h1>Bienvenue sur le tableau-de-bord</h1>
    <p>Email : <%= user.email %></p>
    <p>Date : <%= new Date().toLocaleDateString('fr-FR') %></p>

    <section>
      <h2>Réservations en cours</h2>
      <% if (reservations.length === 0) { %>
        <p>Aucune réservation active.</p>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>Nom du bateau</th>
              <th>Propriétaire</th>
              <th>Catway</th>
              <th>Du</th>
              <th>Au</th>
            </tr>
          </thead>
          <tbody>
            <% reservations.forEach(r => { %>
              <tr>
                <td><%= r.boatName %></td>
                <td><%= r.clientName %></td>
                <td><%= r.catwayNumber %></td>                
                <td><%= new Date(r.startDate).toLocaleDateString('fr-FR') %></td>
                <td><%= new Date(r.endDate).toLocaleDateString('fr-FR') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </section>
  </main>
</body>
</html>

